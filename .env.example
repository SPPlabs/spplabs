# PostgreSQL Database Connection String (Source of truth)
DATABASE_URL="postgresql://postgres:password@localhost:5432/spplabs?schema=public"

# JWT Secret Key (for signing dashboard sessions)
# Generate a secure 64+ character random string in production
# Example: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_STRING"

# Admin password for database seeding (only needed when running prisma db seed)
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# Central API URL endpoint (accessible on the client-side for the simulator)
NEXT_PUBLIC_API_URL="https://api.spplabs.es"

# The API key of spplabs.es itself (to enable the public contact/booking forms on the admin landing page)
NEXT_PUBLIC_SPP_API_KEY="spp_api_xxxxxxxxxxxxxxxx"

# ClickHouse Analytics Database
# Set CLICKHOUSE_HOST to enable analytics. If empty, the app runs in mock mode with simulated data.
CLICKHOUSE_HOST="http://clickhouse:8123"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="analytics"

# vLLM Server served model name (Optional, defaults to qwen3-4b)
VLLM_MODEL="qwen3-4b"

# Resend Email Delivery Engine
# Get your API key from https://resend.com/api-keys
# If empty, the app runs in development mock mode (logs sent emails to console).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email sender address (must be a domain verified in Resend, e.g. notificaciones@spplabs.es)
# For initial testing before domain verification, you can use: onboarding@resend.dev
EMAIL_FROM_ADDRESS="notificaciones@spplabs.es"

# Cron Job Secret (for securing /api/cron/scheduled-emails worker endpoint)
CRON_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_CRON_SECRET"

# Google Calendar OAuth 2.0 Integration
GOOGLE_CLIENT_ID="CHANGE_ME_TO_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CHANGE_ME_TO_GOOGLE_CLIENT_SECRET"
NEXT_PUBLIC_APP_URL="https://spplabs.es"
