datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WebsiteRole {
  ADMIN
  USER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Website {
  id                      String                    @id @default(uuid()) @db.Uuid
  domain                  String                    @unique
  displayName             String                    @map("display_name")
  passwordHash            String?                   @map("password_hash")
  role                    WebsiteRole
  registeredAt            DateTime?                 @map("registered_at") @db.Timestamptz
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  logoUrl                 String?                   @map("logo_url")
  
  apiKeys                 WebsiteApiKey[]
  contactForms            ContactForm[]
  bookings                Booking[]
  notifications           Notification[]
  supportRequests         SupportRequest[]
  aiUsageMonthly          AiUsageMonthly[]
  chatbotKnowledge        ChatbotKnowledge?
  googleCalendarConnection GoogleCalendarConnection?
  
  viewerDashboardStates   WebsiteDashboardState[]   @relation("ViewerWebsite")
  targetDashboardStates   WebsiteDashboardState[]   @relation("TargetWebsite")
  chatConversations       ChatConversation[]
  emailConfig             WebsiteEmailConfig?
  scheduledEmails         ScheduledEmail[]
  dashboardNotes          DashboardNote[]

  @@map("websites")
}

model SignupToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  domain    String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("signup_tokens")
}

model WebsiteApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  websiteId  String    @map("website_id") @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  
  website    Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, name])
  @@map("website_api_keys")
}

model ContactForm {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @map("website_id") @db.Uuid
  name      String
  phone     String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@map("contact_forms")
}

model Booking {
  id        String        @id @default(uuid()) @db.Uuid
  websiteId String        @map("website_id") @db.Uuid
  date      DateTime      @db.Date
  time      String        // TIME is stored as hh:mm format string for simplicity and consistency in client interfaces
  name      String
  phone     String
  email     String
  message   String
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  website   Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([websiteId, date])
  @@map("bookings")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String?  @map("website_id") @db.Uuid
  title     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  website   Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@map("notifications")
}

model SupportRequest {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @map("website_id") @db.Uuid
  title     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@map("support_requests")
}

model AiUsageMonthly {
  id               String   @id @default(uuid()) @db.Uuid
  websiteId        String   @map("website_id") @db.Uuid
  year             Int
  month            Int
  promptTokens     BigInt   @default(0) @map("prompt_tokens")
  completionTokens BigInt   @default(0) @map("completion_tokens")
  totalTokens      BigInt   @default(0) @map("total_tokens")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, year, month])
  @@map("ai_usage_monthly")
}

model ChatbotKnowledge {
  id           String    @id @default(uuid()) @db.Uuid
  websiteId    String    @unique @map("website_id") @db.Uuid
  content      String
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  website      Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("chatbot_knowledge")
}

model GoogleCalendarConnection {
  id                 String   @id @default(uuid()) @db.Uuid
  websiteId          String   @unique @map("website_id") @db.Uuid
  googleAccountEmail String   @map("google_account_email")
  googleCalendarId   String   @map("google_calendar_id")
  accessToken        String   @map("access_token")
  refreshToken       String   @map("refresh_token")
  tokenExpiresAt     DateTime @map("token_expires_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  website            Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

model WebsiteDashboardState {
  id                   String    @id @default(uuid()) @db.Uuid
  viewerWebsiteId      String    @map("viewer_website_id") @db.Uuid
  targetWebsiteId      String    @map("target_website_id") @db.Uuid
  lastContactView      DateTime? @map("last_contact_view") @db.Timestamptz
  lastBookingView      DateTime? @map("last_booking_view") @db.Timestamptz
  lastNotificationView DateTime? @map("last_notification_view") @db.Timestamptz
  lastSupportView      DateTime? @map("last_support_view") @db.Timestamptz

  viewerWebsite        Website   @relation("ViewerWebsite", fields: [viewerWebsiteId], references: [id], onDelete: Cascade)
  targetWebsite        Website   @relation("TargetWebsite", fields: [targetWebsiteId], references: [id], onDelete: Cascade)

  @@unique([viewerWebsiteId, targetWebsiteId])
  @@map("website_dashboard_state")
}

enum ChatSender {
  VISITOR
  BOT
  AGENT
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

model ChatConversation {
  id            String             @id @default(uuid()) @db.Uuid
  websiteId     String             @map("website_id") @db.Uuid
  visitorId     String             @map("visitor_id")
  visitorName   String?            @map("visitor_name")
  visitorEmail  String?            @map("visitor_email")
  status        ConversationStatus @default(ACTIVE)
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz
  lastMessageAt DateTime           @default(now()) @updatedAt @map("last_message_at") @db.Timestamptz

  website       Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@index([websiteId])
  @@index([websiteId, lastMessageAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  sender         ChatSender
  content        String
  tokens         Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

enum EmailType {
  WELCOME_CONTACT
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  GOOGLE_REVIEW_REQUEST
  TEST_EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model WebsiteEmailConfig {
  id                         String   @id @default(uuid()) @db.Uuid
  websiteId                  String   @unique @map("website_id") @db.Uuid
  senderName                 String   @default("Atención al Cliente") @map("sender_name")
  replyToEmail               String?  @map("reply_to_email")
  googleReviewUrl            String?  @map("google_review_url")
  
  enableWelcomeEmail         Boolean  @default(true) @map("enable_welcome_email")
  enableBookingConfirm       Boolean  @default(true) @map("enable_booking_confirm")
  enableBookingReminder      Boolean  @default(true) @map("enable_booking_reminder")
  reminderHoursBefore        Int      @default(24) @map("reminder_hours_before")
  
  // Google Review Booster triggers (Citas y Formularios de Contacto)
  enableReviewRequest        Boolean  @default(true) @map("enable_review_request")
  reviewDelayHours           Int      @default(2) @map("review_delay_hours")
  enableBookingReviewRequest Boolean  @default(true) @map("enable_booking_review_request")
  bookingReviewDelayHours    Int      @default(2) @map("booking_review_delay_hours")
  enableContactReviewRequest Boolean  @default(false) @map("enable_contact_review_request")
  contactReviewDelayHours    Int      @default(24) @map("contact_review_delay_hours")
  
  brandColor                 String   @default("#0284c7") @map("brand_color")
  customLogoUrl              String?  @map("custom_logo_url")
  
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  website                    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@map("website_email_configs")
}

model ScheduledEmail {
  id              String         @id @default(uuid()) @db.Uuid
  websiteId       String         @map("website_id") @db.Uuid
  recipientEmail  String         @map("recipient_email")
  recipientName   String         @map("recipient_name")
  subject         String
  emailType       EmailType      @map("email_type")
  status          DeliveryStatus @default(PENDING)
  scheduledFor    DateTime       @map("scheduled_for") @db.Timestamptz
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz
  metadata        Json?
  error           String?

  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  website         Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([websiteId])
  @@map("scheduled_emails")
}

enum NoteType {
  NOTE
  CLIENT
  STAFF
}

model DashboardNote {
  id           String    @id @default(uuid()) @db.Uuid
  websiteId    String    @map("website_id") @db.Uuid
  type         NoteType  @default(NOTE)
  title        String
  content      String    @db.Text
  email        String?
  phone        String?
  role         String?
  tag          String?
  color        String?
  pinned       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  website      Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([pinned, updatedAt])
  @@map("dashboard_notes")
}

